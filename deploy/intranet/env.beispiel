# Kopie dieser Datei als ".env" auf den SERVER legen und ausfuellen.
# Die echten Werte stehen in der .env auf deinem PC - dort abschreiben, nie per Mail schicken.
# Diese Vorlage enthaelt bewusst keine echten Zugangsdaten.

# --- Betrieb im Internet -------------------------------------------------
INTRANET_DOMAIN=intranet.medienwerk-kw.de
APP_ENV=production
# Pflicht: mindestens 8 Zeichen, besser deutlich laenger. Ohne Passwort startet die Anwendung im Internet nicht.
DASHBOARD_USER=medienwerk
DASHBOARD_PASSWORD=HIER-PASSWORT-EINTRAGEN

DATABASE_URL=sqlite:///./data/pod_studio.db
STUDIO_ENABLED=true
STUDIO_DAILY_BUDGET_USD=-1
USE_MOCKS=true
MOCK_EBAY=false
BACKGROUND_JOBS_ENABLED=true

# --- Aus der .env deines PCs uebernehmen --------------------------------
OPENAI_API_KEY=
SELLER_NAME=
SELLER_ADDRESS=
SELLER_EMAIL=
SELLER_TAX_ID=
INVOICE_NUMBER_PREFIX=
EBAY_MERCHANT_LOCATION_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_REFRESH_TOKEN=
EBAY_WAREHOUSE_POSTAL=
EBAY_WAREHOUSE_CITY=
EBAY_AUTO_VEROEFFENTLICHEN=false
TREND_RADAR_TAEGLICH=false
TREND_ANZAHL=
TREND_MODELL=

# Optional (nur wenn du sie benutzt):
# SPREADSHIRT_API_KEY=
# SPREADSHIRT_API_SECRET=
# SPREADSHIRT_SHOP_ID=
# SPREADSHIRT_BASE_URL=
# SPREADSHIRT_USER_AGENT=
# EBAY_DELETION_ENDPOINT_URL=
# EBAY_LOESCH_ABHOL_URL=
# EBAY_IPN_VERIFICATION_TOKEN=
# EBAY_LOESCH_ABHOL_TOKEN=
