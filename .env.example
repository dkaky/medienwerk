# ============================================================================
#  .env-VORLAGE fuer Medienwerk / POD Shop
#  -> kopiere diese Datei nach ".env". Die echte .env wird NIE committet.
#
#  Fuer lokale Entwicklung brauchst du KEINE echten Zugangsdaten:
#  USE_MOCKS=true simuliert eBay und LLM komplett - kein echtes Geld, keine
#  echten Aufrufe nach draussen.
#
#  Alle Felder samt Doku stehen in app/config.py. Alle haben Vorgabewerte,
#  eine kurze .env reicht also.
# ============================================================================

# --- Basis (das reicht fuer lokale Entwicklung) ---
APP_ENV=development
# true = alles gemockt (Standard)
USE_MOCKS=true
# leer = kein Login (nur lokal ok!)
DASHBOARD_PASSWORD=
DATABASE_URL=sqlite:///./data/ebay_store.db

# --- Optional: einzelne Integrationen echt schalten ---
# MOCK_LLM=false
# MOCK_EBAY=false                   # Achtung: schaltet Schreibzugriff auf eBay frei

# ============================================================================
#  Stammdaten Medienwerk - stehen auf jeder § 19-Rechnung
# ============================================================================
SELLER_NAME=Medienwerk
# Zeilen mit | trennen. Der Inhabername ist nach § 5 DDG Pflicht.
SELLER_ADDRESS=Inhaber: Aleyna Nur Aydin | Hauptstraße 439 | 53639 Königswinter
SELLER_EMAIL=medienwerk@outlook.com
# Steuernummer; bei § 19 optional
SELLER_TAX_ID=
# ergibt MW-2026-0001, MW-2026-0002, ...
INVOICE_NUMBER_PREFIX=MW

# Lagerort bei eBay ("Versand aus"). Muss der echte Standort sein.
EBAY_MERCHANT_LOCATION_KEY=MW-DE-01
# EBAY_WAREHOUSE_ADDRESS_LINE=
# EBAY_WAREHOUSE_POSTAL=
# EBAY_WAREHOUSE_CITY=
# EBAY_WAREHOUSE_COUNTRY=DE

# ============================================================================
#  Zugangsdaten - hier nur eintragen, was du wirklich benutzt
# ============================================================================

# --- eBay (developer.ebay.com) ---
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_REFRESH_TOKEN=
# EBAY_IPN_VERIFICATION_TOKEN=

# --- Bilderzeugung (Studio). Ohne Tagesbudget wird nichts erzeugt. ---
# OPENAI_API_KEY=
# FAL_API_KEY=
# STUDIO_ENABLED=true
# STUDIO_DAILY_BUDGET_USD=5

# --- Printify (Druckerei fuer eigene Motive) ---
# PRINTIFY_TOKEN=
# PRINTIFY_SHOP_ID=

# --- Spreadshirt (Public Shop API) -----------------------------------------
# Key holen: Partnerbereich -> https://partner.spreadshirt.de/apiKey
# EU-Plattform (api.spreadshirt.net) und NA (.com) haben GETRENNTE Keys.
# Es genuegt, hier Key, Secret und Shop-ID einzutragen - der Rest steht schon.
# SPREADSHIRT_API_KEY=
# SPREADSHIRT_API_SECRET=
# SPREADSHIRT_SHOP_ID=
SPREADSHIRT_BASE_URL=https://api.spreadshirt.net/api/v1
SPREADSHIRT_USER_AGENT=Medienwerk-POD-Shop/1.0 (https://www.ebay.de/str/druckhelden; medienwerk@outlook.com)

# --- DHL Sendungsverfolgung (developer.dhl.com). Leer = aus. ---
# DHL_API_KEY=
