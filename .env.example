# ============================================================================
#  .env-VORLAGE  ->  kopiere diese Datei nach ".env"  (die echte .env wird NIE committet)
#
#  WICHTIG: Fuer LOKALE ENTWICKLUNG brauchst du KEINE echten Zugangsdaten.
#  use_mocks=true simuliert eBay/AliExpress/LLM komplett — kein echtes Geld, keine
#  echten API-Calls. Die ECHTEN Keys liegen ausschliesslich auf dem Live-VPS
#  (dort schon konfiguriert). Du brauchst sie NUR, wenn du bewusst gegen die echten
#  Dienste testen willst — dann bekommst du sie separat vom Miteigentuemer.
#
#  Alle Felder + Doku: app/config.py. Alle haben Defaults -> eine minimale .env reicht.
# ============================================================================

# --- Basis (das reicht fuer lokale Entwicklung) ---
APP_ENV=development
USE_MOCKS=true                      # true = alles gemockt (Standard, empfohlen fuer Dev)
DASHBOARD_PASSWORD=                 # leer = kein Login (fuer Dev ok); setzen fuer Login-Schutz
DATABASE_URL=sqlite:///./data/ebay_store.db

# --- Optional: einzelne Integrationen echt schalten (nur mit echten Keys sinnvoll) ---
# MOCK_LLM=false
# MOCK_EBAY=false
# MOCK_ALIEXPRESS=false

# --- ECHTE Zugangsdaten: NUR fuer die Live-Instanz noetig, NICHT fuer lokale Dev. ---
# NIE ins Repo committen. Vom Miteigentuemer beziehen.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_REFRESH_TOKEN=
# EBAY_IPN_VERIFICATION_TOKEN=
# ALIEXPRESS_APP_KEY=
# ALIEXPRESS_APP_SECRET=
# ALIEXPRESS_ACCESS_TOKEN=
# ALIEXPRESS_REFRESH_TOKEN=
# ANTHROPIC_API_KEY=
# AUTODS_API_KEY=
# DHL Shipment-Tracking-API (developer.dhl.com) – echtes Zustelldatum. Leer = aus.
# DHL_API_KEY=
